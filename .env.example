# Core Application Settings
ENVIRONMENT=local  # 'local' or 'prod'

# Database Configuration
DB_USER=app
DB_PASSWORD=app
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app

# Authentication
JWT_SECRET=change-me-in-production
JWT_ALG=HS256

# Security
RATE_LIMIT_PER_MINUTE=60
ADMIN_BOOTSTRAP_PASSWORD=admin  # Initial admin password (if not set, random generated)
ADMIN_BOOTSTRAP_PASSWORD_FORCE=false # Set to true to reset admin password on startup

# Ollama Integration
OLLAMA_BASE_URL=http://localhost:11434 # Or http://ollama:11434 in docker
